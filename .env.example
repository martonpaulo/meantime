# Optional release configuration. Examples only; not loaded by the build scripts.
# Copy the names you need into your own shell environment. Keep credentials in
# Keychain; never put credential values in this file or a committed .env file.

# Developer ID identity label (not a certificate or private key).
# export DEVELOPER_ID_IDENTITY="Developer ID Application: Example Name (TEAMID)"
# Existing notarytool Keychain profile name (not a password).
# export NOTARY_PROFILE="meantime-notary"

# Choose unused output paths for every run; existing artifacts are retained.
# export APP_OUTPUT="artifacts/unique-run/Meantime.app"
# export ZIP_OUTPUT="artifacts/unique-run/Meantime.zip"
# export DMG_OUTPUT="artifacts/unique-run/Meantime.dmg"
# export DMG_WORK_DIR="artifacts/unique-run/dmg-work"

# Optional Swift executable override consumed by make development targets.
# export SWIFT="swift"
# VERSION, BUILD, ZIP, DMG, and SIG are explicit make arguments documented by
# make help and the release commands; they are not credentials.
